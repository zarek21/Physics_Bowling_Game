.RootContainer {
    width: 100%;
    height: 100%;
    position: absolute;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 80px;
}

.SliderContainer {
    width: 750px;
    align-items: center;
    justify-content: center;
}

.Slider {
    margin: 0;
    margin-top: 10px;
    padding: 0;
    position: relative;
    width: 100%;
    height: 44px;
}

.Slider .unity-base-slider,
.Slider .unity-base-field {
    margin: 0;
    padding: 0;
    height: 44px;
}

.Slider .unity-slider__label,
.Slider .unity-base-slider__label,
.Slider .unity-base-field__label {
    display: none;
}

.Slider .unity-slider__input,
.Slider .unity-base-slider__input,
.Slider .unity-base-field__input {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    background-color: transparent;
    border-width: 0;
    height: 100%;
}

.Slider .unity-slider__drag-container,
.Slider .unity-base-slider__drag-container {
    height: 100%;
    justify-content: center;
}

.Slider .unity-slider__tracker,
.Slider .unity-base-slider__tracker {
    background-color: #f79303;
    background-image: none;
    height: 44px;
    border-radius: 22px;
    border-width: 3px;
    border-color: #ffffff;
    margin: 0;
    padding: 0;
}

.Slider .unity-slider__dragger,
.Slider .unity-base-slider__dragger {
    background-color: #3d1a03;
    background-image: none;
    width: 56px;
    height: 56px;
    border-radius: 28px;
    border-width: 3px;
    border-color: #ffffff;
    margin-top: -6px;
    padding: 0;
}

.Slider .unity-slider__dragger:hover,
.Slider .unity-base-slider__dragger:hover,
.Slider .unity-slider__dragger:active,
.Slider .unity-base-slider__dragger:active {
    background-color: #3d1a03;
    background-image: none;
    border-width: 3px;
    border-color: #ffffff;
}

.InstructionsContainer {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(61, 26, 3, 0.85);
    border-radius: 34px;
    padding: 14px 40px;
    border-width: 2px;
    border-color: #f79303;
    margin-top: 60px;
}

.InstructionRow {
    flex-direction: row;
    align-items: center;
    margin-right: 60px;
}

.KeyIcon {
    width: 56px;
    height: 56px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.KeyIcon.SpaceKey {
    width: 116px;
}

.AKey {
    background-image: url("project://database/Assets/_Project/Art/Sprites/WhiteKeyboards/A.png");
}

.DKey {
    background-image: url("project://database/Assets/_Project/Art/Sprites/WhiteKeyboards/D.png");
}

.SpaceKey {
    background-image: url("project://database/Assets/_Project/Art/Sprites/WhiteKeyboards/Space.png");
}

.InstructionText {
    color: #ffffff;
    font-size: 20px;
    -unity-font-style: bold;
    margin-left: 16px;
}

.FrictionLabelContainer {
    background-color: rgba(61, 26, 3, 0.85);
    border-radius: 20px;
    padding: 6px 24px;
    border-width: 2px;
    border-color: #f79303;
    margin-bottom: -20px;
    align-self: center;
}

.FrictionLabel {
    color: #ffffff;
    font-size: 18px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}
