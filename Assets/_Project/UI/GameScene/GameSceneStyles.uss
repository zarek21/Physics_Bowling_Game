.RootContainer {
    width: 100%;
    height: 100%;
    position: absolute;
    justify-content: flex-end;
    align-items: center;
}

.SliderContainer {
    width: 750px;
    align-items: center;
    justify-content: center;
    margin-bottom: 80px;
}

.Slider {
    margin: 0;
    margin-top: 10px;
    padding: 0;
    position: relative;
    width: 100%;
    height: 44px;
}

.Slider .unity-base-slider,
.Slider .unity-base-field {
    margin: 0;
    padding: 0;
    height: 44px;
}

.Slider .unity-slider__label,
.Slider .unity-base-slider__label,
.Slider .unity-base-field__label {
    display: none;
}

.Slider .unity-slider__input,
.Slider .unity-base-slider__input,
.Slider .unity-base-field__input {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    background-color: transparent;
    border-width: 0;
    height: 100%;
}

.Slider .unity-slider__drag-container,
.Slider .unity-base-slider__drag-container {
    height: 100%;
    justify-content: center;
}

.Slider .unity-slider__tracker,
.Slider .unity-base-slider__tracker {
    background-color: #f79303;
    background-image: none;
    height: 44px;
    border-radius: 22px;
    border-width: 3px;
    border-color: #ffffff;
    margin: 0;
    padding: 0;
}

.Slider .unity-slider__dragger,
.Slider .unity-base-slider__dragger {
    background-color: #3d1a03;
    background-image: none;
    width: 56px;
    height: 56px;
    border-radius: 28px;
    border-width: 3px;
    border-color: #ffffff;
    margin-top: -6px;
    padding: 0;
}

.Slider .unity-slider__dragger:hover,
.Slider .unity-base-slider__dragger:hover,
.Slider .unity-slider__dragger:active,
.Slider .unity-base-slider__dragger:active {
    background-color: #3d1a03;
    background-image: none;
    border-width: 3px;
    border-color: #ffffff;
}

.InstructionsContainer {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(61, 26, 3, 0.85);
    border-radius: 34px;
    padding: 14px 40px;
    border-width: 2px;
    border-color: #f79303;
    margin-top: 60px;
}

.InstructionRow {
    flex-direction: row;
    align-items: center;
    margin-right: 60px;
}

.KeyIcon {
    width: 56px;
    height: 56px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.KeyIcon.SpaceKey {
    width: 116px;
}

.AKey {
    background-image: url("project://database/Assets/_Project/Art/Sprites/WhiteKeyboards/A.png");
}

.DKey {
    background-image: url("project://database/Assets/_Project/Art/Sprites/WhiteKeyboards/D.png");
}

.SpaceKey {
    background-image: url("project://database/Assets/_Project/Art/Sprites/WhiteKeyboards/Space.png");
}

.InstructionText {
    color: #ffffff;
    font-size: 20px;
    -unity-font-style: bold;
    margin-left: 16px;
}

.FrictionLabelContainer {
    background-color: rgba(61, 26, 3, 0.85);
    border-radius: 20px;
    padding: 6px 24px;
    border-width: 2px;
    border-color: #f79303;
    margin-bottom: -20px;
    align-self: center;
}

.FrictionLabel {
    color: #ffffff;
    font-size: 18px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.Hidden {
    display: none;
}

.ModalContainer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.75);
}

.ModalContent {
    width: 750px;
    background-color: rgba(0, 0, 0, 0.45);
    border-width: 3px;
    border-color: #ffffff;
    border-radius: 25px;
    padding: 60px;
    align-items: center;
}

.ModalTitle {
    font-size: 52px;
    -unity-font-style: bold;
    margin-bottom: 45px;
    -unity-text-align: middle-center;
}

.WinTitle {
    color: #ffd700;
}

.LoseTitle {
    color: #ff3b30;
}

.ModalButton {
    background-color: transparent;
    color: #ffffff;
    font-size: 26px;
    -unity-font-style: bold;
    border-width: 3px;
    border-color: #ffffff;
    border-radius: 15px;
    padding: 0 30px;
    width: auto;
    min-width: 330px;
    height: 70px;
    justify-content: center;
    align-items: center;
    margin-top: 15px;
}

.ModalButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
}

.ModalButton:active {
    background-color: rgba(255, 255, 255, 0.2);
}

.ResetThrowButton {
    position: absolute;
    left: 40px;
    top: 40px;
    background-color: rgba(61, 26, 3, 0.85);
    color: #ffffff;
    font-size: 24px;
    -unity-font-style: bold;
    border-width: 2px;
    border-color: #f79303;
    border-radius: 20px;
    padding: 6px 35px;
    transition: scale 0.15s ease-in-out;
    width: 300px;
    height: 50px;
   
}

.ResetThrowButton:hover {
    scale: 1.08;
}

.ResetThrowButton:active {
    scale: 1;
}

.VictoryProgressContainer {
    position: absolute;
    top: 40px;
    align-self: center;
    width: 450px;
    background-color: rgba(61, 26, 3, 0.85);
    border-width: 2px;
    border-color: #f79303;
    border-radius: 15px;
    padding: 15px 25px;
    align-items: center;
    justify-content: center;
}

.VictoryProgressLabel {
    color: #ffffff;
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.VictoryProgressBarBg {
    width: 100%;
    height: 16px;
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
}

.VictoryProgressBarFill {
    height: 100%;
    background-color: #f79303;
    border-radius: 8px;
    transition: width 0.05s ease-out;
}

/* Estilos de la Pantalla Cómo Jugar */
.HowToPlayContent {
    width: 750px;
    background-color: rgba(61, 26, 3, 0.95);
    border-color: #f79303;
    border-width: 3px;
    border-radius: 30px;
    padding: 55px;
    align-items: center;
}

.HowToPlayHeader {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 30px;
}

.InfoIcon {
    width: 60px;
    height: 60px;
    margin-right: 20px;
    background-image: url("project://database/Assets/_Project/UI/GameScene/info-icon.svg");
    -unity-background-scale-mode: scale-to-fit;
}

.HowToPlayTitle {
    color: #f79303;
    font-size: 46px;
    margin: 0;
    -unity-font-style: bold;
}

.HowToPlayDescription {
    color: #ffffff;
    font-size: 24px;
    -unity-text-align: middle-center;
    margin-bottom: 40px;
    white-space: normal;
}

/* Botones de Control de Fricción */
.FrictionStepButton {
    width: 50px;
    height: 50px;
    background-color: #3d1a03;
    color: #ffffff;
    font-size: 28px;
    -unity-font-style: bold;
    border-radius: 25px;
    border-width: 3px;
    border-color: #ffffff;
    justify-content: center;
    align-items: center;
    margin: 0;
    padding: 0;
    padding-bottom: 3px;
    transition: scale 0.15s ease-in-out;
}

.FrictionStepButton:hover {
    scale: 1.1;
    background-color: #5a2705;
}

.FrictionStepButton:active {
    scale: 0.95;
    background-color: #f79303;
    border-color: #f79303;
}
